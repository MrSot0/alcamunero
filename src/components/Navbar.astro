---
// src/components/Navbar.astro
// Escritorio (lg+): cabecera con logos + menú horizontal.
// Móvil: estilo app → barra superior compacta + barra de pestañas fija abajo
// (Inicio, Actualidad, Cultura, Deportes, Más) y una hoja inferior con el resto.
import { sections } from '../data/articles';

interface Props {
  /** 'inicio' | 'directorio' | id de sección */
  active?: string;
}

const { active = 'inicio' } = Astro.props;

const items = [
  { id: 'inicio', label: 'Inicio', href: '/' },
  ...Object.entries(sections).map(([id, s]) => ({
    id,
    label: s.label,
    href: `/seccion/${id}`,
  })),
  { id: 'directorio', label: 'Directorio', href: '/directorio' },
];

// Íconos (trazo outline, viewBox 24x24)
const icons: Record<string, string> = {
  inicio: 'M3 10.5L12 3l9 7.5V20a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1v-9.5z',
  actualidad:
    'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z',
  cultura: 'M9 19V6l12-3v13M9 19a3 3 0 11-6 0 3 3 0 016 0zm12-3a3 3 0 11-6 0 3 3 0 016 0z',
  deportes: 'M13 10V3L4 14h7v7l9-11h-7z',
  opinion:
    'M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z',
  reportajes:
    'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  directorio:
    'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  eventos:
    'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  religion: 'M12 3v18M7 8h10',
  comunidad:
    'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
  ciencia:
    'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  efemerides: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  mas: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z',
};

// Pestañas fijas abajo; el resto va en la hoja "Más"
const primaryIds = ['inicio', 'actualidad', 'cultura', 'deportes'];
const primary = items.filter((i) => primaryIds.includes(i.id));
const more = items.filter((i) => !primaryIds.includes(i.id));
const moreActive = more.some((i) => i.id === active);

const activeClass = 'text-cyan-300 bg-blue-950 shadow-sm';
const idleClass = 'text-blue-100 hover:bg-blue-800 hover:text-cyan-300';
---

<header id="main-navbar" class="bg-blue-950 text-white sticky top-0 z-50 shadow-md border-b border-blue-900 transition-transform duration-300 ease-in-out">

  <!-- ===== MÓVIL: barra superior compacta (estilo app bar) ===== -->
  <div class="lg:hidden grid grid-cols-[3rem_1fr_3rem] items-center gap-2 px-3 h-14">
    <a href="/" class="block" aria-label="Ir al inicio">
      <img src="/logo.png" alt="Logo Institucional" class="h-9 w-auto object-contain" />
    </a>

    <a href="/" class="block text-center leading-none">
      <span class="block text-lg font-serif font-extrabold tracking-tight text-white">ALCAMUNERO</span>
      <span class="block mt-1 text-[8px] uppercase tracking-[0.25em] text-cyan-400 font-semibold">Periódico Digital</span>
    </a>

    <a href="/" class="block justify-self-end" aria-label="Ir al inicio">
      <img src="/avec.png" alt="Logo AVEC" class="h-9 w-auto object-contain" />
    </a>
  </div>

  <!-- ===== ESCRITORIO: franja superior + logos + menú ===== -->
  <div class="hidden lg:block">
    <div class="max-w-7xl mx-auto px-3 py-1 text-xs border-b border-blue-900/60 flex justify-between items-center text-blue-200">
      <span>Cárdenas, Táchira — Venezuela</span>
      <div class="flex items-center space-x-2">
        <span class="font-medium text-cyan-400">Edición Digital Interactiva</span>
        <span id="current-date" class="text-blue-300">Cargando fecha...</span>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-3 py-2.5 grid grid-cols-3 items-center">
      <div class="flex justify-start items-center">
        <a href="/" class="block cursor-pointer">
          <img src="/logo.png" alt="Logo Institucional" class="h-12 w-auto object-contain hover:opacity-95 transition-opacity" />
        </a>
      </div>

      <div class="text-center">
        <a href="/" class="inline-block group space-y-0.5 cursor-pointer">
          <span class="block text-3xl font-serif font-extrabold tracking-tight text-white group-hover:text-cyan-300 transition-colors leading-tight">
            ALCAMUNERO
          </span>
          <span class="block text-[9px] uppercase tracking-widest text-cyan-400 font-semibold">Periódico Digital</span>
        </a>
      </div>

      <div class="flex justify-end items-center">
        <a href="/" class="block cursor-pointer">
          <img src="/avec.png" alt="Logo AVEC" class="h-12 w-auto object-contain hover:opacity-95 transition-opacity" />
        </a>
      </div>
    </div>

    <nav aria-label="Secciones del periódico" class="bg-blue-900/80 backdrop-blur-md border-t border-blue-800">
      <div class="max-w-7xl mx-auto px-3 py-2">
        <ul class="flex flex-row flex-wrap items-center justify-center gap-1 text-sm font-semibold tracking-wide">
          {items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={active === item.id ? 'page' : undefined}
                class:list={[
                  'block px-3 py-1.5 rounded transition-colors',
                  active === item.id ? activeClass : idleClass,
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>
</header>

<!-- ===== MÓVIL: barra de pestañas inferior ===== -->
<nav
  aria-label="Navegación principal"
  class="tab-bar lg:hidden fixed bottom-0 inset-x-0 z-50 bg-blue-950/95 backdrop-blur-md border-t border-blue-900 shadow-[0_-4px_16px_rgba(0,0,0,0.25)]"
>
  <ul class="grid grid-cols-5 max-w-lg mx-auto">
    {primary.map((item) => (
      <li>
        <a
          href={item.href}
          aria-current={active === item.id ? 'page' : undefined}
          class:list={[
            'tab-item flex flex-col items-center gap-0.5 pt-2 pb-1.5 text-[10px] font-semibold tracking-wide transition-colors',
            active === item.id ? 'text-cyan-300' : 'text-blue-200/80 active:text-white',
          ]}
        >
          <span
            class:list={[
              'flex items-center justify-center h-7 w-14 rounded-full transition-colors',
              active === item.id ? 'bg-blue-800/80' : 'bg-transparent',
            ]}
          >
            <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d={icons[item.id]}></path>
            </svg>
          </span>
          <span>{item.label}</span>
        </a>
      </li>
    ))}

    <li>
      <button
        type="button"
        id="more-toggle"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="more-sheet"
        class:list={[
          'tab-item w-full flex flex-col items-center gap-0.5 pt-2 pb-1.5 text-[10px] font-semibold tracking-wide transition-colors',
          moreActive ? 'text-cyan-300' : 'text-blue-200/80 active:text-white',
        ]}
      >
        <span
          class:list={[
            'flex items-center justify-center h-7 w-14 rounded-full transition-colors',
            moreActive ? 'bg-blue-800/80' : 'bg-transparent',
          ]}
        >
          <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d={icons.mas}></path>
          </svg>
        </span>
        <span>Más</span>
      </button>
    </li>
  </ul>
</nav>

<!-- ===== MÓVIL: hoja inferior "Más" ===== -->
<div id="more-sheet" class="more-sheet lg:hidden fixed inset-0 z-[60]" data-open="false" role="dialog" aria-modal="true" aria-label="Más secciones">
  <div class="sheet-backdrop absolute inset-0 bg-black/60" data-sheet-close></div>

  <div class="sheet-panel absolute bottom-0 inset-x-0 bg-blue-950 text-white rounded-t-2xl border-t border-blue-800 shadow-2xl">
    <div class="flex justify-center pt-2.5 pb-1">
      <span class="h-1 w-10 rounded-full bg-blue-700"></span>
    </div>

    <div class="flex items-center justify-between px-5 pt-1 pb-2">
      <h2 class="font-serif text-lg font-bold">Más secciones</h2>
      <button type="button" data-sheet-close aria-label="Cerrar" class="p-2 -mr-2 text-blue-200 hover:text-white">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <ul class="px-3 pb-3 divide-y divide-blue-900 max-h-[60vh] overflow-y-auto overscroll-contain">
      {more.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={active === item.id ? 'page' : undefined}
            class:list={[
              'flex items-center gap-4 px-3 py-3.5 rounded-lg text-sm font-semibold transition-colors',
              active === item.id ? 'text-cyan-300 bg-blue-900/70' : 'text-blue-100 active:bg-blue-900',
            ]}
          >
            <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d={icons[item.id]}></path>
            </svg>
            <span class="flex-1">{item.label}</span>
            <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </li>
      ))}
    </ul>

    <!-- Espacio para la zona segura (barra de gestos del teléfono) -->
    <div style="height: env(safe-area-inset-bottom)"></div>
  </div>
</div>

<style>
  /* Respeta la zona segura de iPhone/Android con gestos */
  .tab-bar {
    padding-bottom: env(safe-area-inset-bottom);
  }

  /* Hoja inferior: animación de entrada/salida */
  .more-sheet {
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 0.3s;
  }
  .more-sheet[data-open='true'] {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }
  .more-sheet .sheet-backdrop {
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .more-sheet[data-open='true'] .sheet-backdrop {
    opacity: 1;
  }
  .more-sheet .sheet-panel {
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .more-sheet[data-open='true'] .sheet-panel {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .more-sheet,
    .more-sheet .sheet-backdrop,
    .more-sheet .sheet-panel {
      transition: none;
    }
  }
</style>

<style is:global>
  /* En móvil, deja espacio abajo para que la barra de pestañas no tape el contenido */
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(4.25rem + env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Fecha (solo se muestra en escritorio)
    const dateEl = document.getElementById('current-date');
    if (dateEl) {
      const hoy = new Date();
      const fechaFormateada = hoy.toLocaleDateString('es-VE', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      });
      dateEl.textContent = fechaFormateada.charAt(0).toUpperCase() + fechaFormateada.slice(1);
    }

    // Barra superior: se oculta al bajar y reaparece al subir
    const navbar = document.getElementById('main-navbar');
    let lastScrollY = window.scrollY;
    let ticking = false;
    const SCROLL_THRESHOLD = 80;

    function handleScroll() {
      const currentScrollY = window.scrollY;
      if (navbar) {
        if (currentScrollY <= SCROLL_THRESHOLD) {
          navbar.classList.remove('-translate-y-full');
        } else if (currentScrollY > lastScrollY) {
          navbar.classList.add('-translate-y-full');
        } else if (currentScrollY < lastScrollY) {
          navbar.classList.remove('-translate-y-full');
        }
      }
      lastScrollY = currentScrollY;
      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(handleScroll);
          ticking = true;
        }
      },
      { passive: true }
    );

    // Hoja "Más"
    const sheet = document.getElementById('more-sheet');
    const toggle = document.getElementById('more-toggle');
    if (!sheet || !toggle) return;

    function setSheet(open: boolean) {
      sheet!.dataset.open = String(open);
      toggle!.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    }

    toggle.addEventListener('click', () => {
      setSheet(sheet.dataset.open !== 'true');
    });

    sheet.querySelectorAll('[data-sheet-close]').forEach((el) => {
      el.addEventListener('click', () => setSheet(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sheet.dataset.open === 'true') setSheet(false);
    });

    // Si se agranda la ventana a escritorio, cierra la hoja
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) setSheet(false);
    });
  });
</script>
