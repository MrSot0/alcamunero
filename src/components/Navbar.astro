---
// src/components/Navbar.astro
import { sections } from '../data/articles';

interface Props {
  /** 'inicio' | 'directorio' | id de sección */
  active?: string;
}

const { active = 'inicio' } = Astro.props;

const items = [
  { id: 'inicio', label: 'Inicio', href: '/' },
  ...Object.entries(sections).map(([id, s]) => ({
    id,
    label: s.label,
    href: `/seccion/${id}`,
  })),
  { id: 'directorio', label: 'Directorio', href: '/directorio' },
];

const activeClass = 'text-cyan-300 bg-blue-950 shadow-sm';
const idleClass = 'text-blue-100 hover:bg-blue-800 hover:text-cyan-300';
---

<header id="main-navbar" class="bg-blue-950 text-white sticky top-0 z-50 shadow-md border-b border-blue-900 transition-transform duration-300 ease-in-out">
  <div class="max-w-7xl mx-auto px-3 py-1 text-[10px] sm:text-xs border-b border-blue-900/60 flex flex-col sm:flex-row justify-between items-center text-blue-200 gap-0.5 sm:gap-0">
    <span class="truncate max-w-full text-center sm:text-left">Cárdenas, Táchira — Venezuela</span>
    <div class="flex items-center space-x-2">
      <span class="hidden sm:inline font-medium text-cyan-400">Edición Digital Interactiva</span>
      <span id="current-date" class="text-blue-300">Cargando fecha...</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-3 py-2.5 grid grid-cols-3 items-center">

    <div class="flex justify-start items-center">
      <a href="/" class="block cursor-pointer">
        <img src="/logo.png" alt="Logo Institucional" class="h-8 sm:h-12 w-auto object-contain hover:opacity-95 transition-opacity" />
      </a>
    </div>

    <div class="text-center">
      <a href="/" class="inline-block group space-y-0.5 cursor-pointer">
        <span class="block text-base sm:text-2xl md:text-3xl font-serif font-extrabold tracking-tight text-white group-hover:text-cyan-300 transition-colors leading-tight">
          ALCAMUNERO
        </span>
        <span class="block text-[6px] sm:text-[9px] uppercase tracking-widest text-cyan-400 font-semibold">Periódico Digital</span>
      </a>
    </div>

    <div class="flex justify-end items-center space-x-3">
      <a href="/" class="hidden sm:block cursor-pointer">
        <img src="/avec.png" alt="Logo AVEC" class="h-8 sm:h-12 w-auto object-contain hover:opacity-95 transition-opacity" />
      </a>

      <button id="menu-toggle" aria-label="Abrir menú de navegación" class="lg:hidden text-cyan-300 hover:text-white focus:outline-none p-1.5 rounded-lg bg-blue-900 border border-blue-800">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

  </div>

  <nav id="menu-container" aria-label="Secciones del periódico" class="max-h-0 lg:max-h-none overflow-hidden transition-all duration-300 ease-in-out bg-blue-900/95 lg:bg-blue-900/80 backdrop-blur-md border-t border-blue-800/0 lg:border-blue-800">
    <div class="max-w-7xl mx-auto px-3 py-3 lg:py-2">
      <ul class="grid grid-cols-2 lg:flex lg:flex-row items-center justify-start lg:justify-center gap-1.5 lg:gap-1 text-xs sm:text-sm font-semibold tracking-wide">
        {items.map((item, i) => (
          <li class:list={[
            'w-full lg:w-auto text-center',
            // Con cantidad impar de ítems, el último ocupa todo el ancho en móvil
            i === items.length - 1 && items.length % 2 === 1 && 'col-span-2 lg:col-span-1',
          ]}>
            <a
              href={item.href}
              aria-current={active === item.id ? 'page' : undefined}
              class:list={[
                'block w-full lg:w-auto px-3 py-2 lg:px-3 lg:py-1.5 rounded-md lg:rounded transition-colors',
                active === item.id ? activeClass : idleClass,
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuToggle = document.getElementById('menu-toggle');
    const menuContainer = document.getElementById('menu-container');
    const dateEl = document.getElementById('current-date');

    if (dateEl) {
      const hoy = new Date();
      const fechaFormateada = hoy.toLocaleDateString('es-VE', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      });
      dateEl.textContent = fechaFormateada.charAt(0).toUpperCase() + fechaFormateada.slice(1);
    }

    const navbar = document.getElementById('main-navbar');
    let lastScrollY = window.scrollY;
    let ticking = false;
    const SCROLL_THRESHOLD = 80;

    function handleScroll() {
      const currentScrollY = window.scrollY;
      const menuOpen = menuContainer && menuContainer.style.maxHeight && menuContainer.style.maxHeight !== '0px';

      if (navbar && !menuOpen) {
        if (currentScrollY <= SCROLL_THRESHOLD) {
          navbar.classList.remove('-translate-y-full');
        } else if (currentScrollY > lastScrollY) {
          navbar.classList.add('-translate-y-full');
        } else if (currentScrollY < lastScrollY) {
          navbar.classList.remove('-translate-y-full');
        }
      }

      lastScrollY = currentScrollY;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(handleScroll);
        ticking = true;
      }
    }, { passive: true });

    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        if (window.innerWidth >= 1024 && menuContainer) {
          menuContainer.style.maxHeight = '';
          menuContainer.classList.remove('border-blue-800');
        }
      }, 100);
    });

    if (menuToggle && menuContainer) {
      menuToggle.addEventListener('click', () => {
        if (menuContainer.style.maxHeight && menuContainer.style.maxHeight !== '0px') {
          menuContainer.style.maxHeight = '0px';
          menuContainer.classList.remove('border-blue-800');
        } else {
          menuContainer.style.maxHeight = menuContainer.scrollHeight + 'px';
          menuContainer.classList.add('border-blue-800');
        }
      });
    }
  });
</script>
