---
// src/components/site/SiteFooter.astro
import Icon from './Icon.astro';
import { site, nav, contact, whatsappLink } from '../../data/site';

const year = new Date().getFullYear();
const cols = [
  { title: 'Colegio', items: nav.find((n) => n.id === 'nosotros')!.children! },
  { title: 'Programa', items: nav.find((n) => n.id === 'programa')!.children! },
];
---

<footer class="bg-deep text-blue-100 mt-16 lg:mt-24 rounded-t-[32px] lg:rounded-t-[56px]">
  <div class="container-site pt-14 pb-8 grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <a href="/" class="flex items-center gap-3">
        <span class="w-14 h-14 rounded-full bg-ivory grid place-items-center"><img src="/logo.png" alt="" class="w-[70%] object-contain" /></span>
        <span class="leading-tight"><span class="block text-white text-lg font-extrabold">{site.name}</span><span class="text-aqua text-sm font-semibold">{site.motto}</span></span>
      </a>
      <p class="mt-5 text-sm leading-relaxed max-w-sm">{site.legalName}. Colegio católico afiliado a la AVEC, formando niños y jóvenes desde {site.foundedDate}.</p>
      <div class="mt-5 flex gap-2">
        <a href={whatsappLink()} target="_blank" rel="noopener" aria-label="WhatsApp" class="w-11 h-11 rounded-full bg-white/10 hover:bg-whatsapp text-white grid place-items-center transition-colors"><Icon brand name="whatsapp" class="w-5 h-5" /></a>
        <a href={`https://www.instagram.com/${contact.instagram}`} target="_blank" rel="noopener" aria-label="Instagram" class="w-11 h-11 rounded-full bg-white/10 hover:bg-brand text-white grid place-items-center transition-colors"><Icon brand name="instagram" class="w-5 h-5" /></a>
        <a href={`mailto:${contact.email}`} aria-label="Correo" class="w-11 h-11 rounded-full bg-white/10 hover:bg-brand text-white grid place-items-center transition-colors"><Icon name="mail" class="w-5 h-5" /></a>
      </div>
    </div>

    {cols.map((c) => (
      <div class="lg:col-span-2">
        <p class="text-white font-bold">{c.title}</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          {c.items.map((i) => <li><a href={i.href} class="hover:text-aqua transition-colors">{i.label}</a></li>)}
        </ul>
      </div>
    ))}

    <div class="lg:col-span-4">
      <p class="text-white font-bold">Visítanos</p>
      <ul class="mt-4 space-y-3 text-sm">
        <li class="flex gap-3"><Icon name="map-pin" class="w-5 h-5 text-aqua mt-0.5" />{contact.addressShort}</li>
        <li class="flex gap-3"><Icon name="clock" class="w-5 h-5 text-aqua mt-0.5" />{contact.hours}</li>
        <li class="flex gap-3"><Icon name="mail" class="w-5 h-5 text-aqua mt-0.5" /><span class="break-all">{contact.email}</span></li>
      </ul>
      <div class="mt-5 flex flex-wrap gap-2">
        <a href="/admisiones" class="btn-aqua !h-11"><Icon name="file-check" class="w-4 h-4" />Admisiones</a>
        <a href="/periodico" class="btn !h-11 bg-white/10 text-white hover:bg-white/20"><Icon name="newspaper" class="w-4 h-4" />Periódico</a>
      </div>
    </div>
  </div>
  <div class="container-site py-6 border-t border-white/10 flex flex-col sm:flex-row gap-3 items-center justify-between text-xs text-blue-200/70">
    <p>© {year} {site.name}. Todos los derechos reservados.</p>
    <div class="flex items-center gap-3">
      <img src="/avec.png" alt="AVEC" class="h-7 opacity-80" />
      <span>Desarrollado por <a href="https://www.instagram.com/mrsoto.dev" target="_blank" rel="noopener" class="text-aqua font-semibold hover:text-white">Marfil Labs</a></span>
    </div>
  </div>
</footer>
