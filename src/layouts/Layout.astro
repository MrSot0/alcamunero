---
// src/layouts/Layout.astro
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Alcamunero | Periódico Digital" } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Alcamunero - Periódico digital de San Cristóbal, Táchira, Venezuela" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans antialiased flex flex-col min-h-screen">
    
    <!-- Navbar Fijo Superior -->
    <Navbar />

    <!-- Contenido Principal (Single Page Sections) -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer Institucional -->
    <Footer />

    <!-- Botones Flotantes -->
    <FloatingButtons />

  </body>
</html>

<style>
  /* Estilos globales opcionales para la tipografía del periódico */
  body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }
  
  h1, h2, h3, .font-serif {
    font-family: Georgia, Cambria, "Times New Roman", Times, serif;
  }
</style>
