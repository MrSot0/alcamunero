---
// src/pages/nosotros.astro
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/site/PageHeader.astro';
import Icon from '../components/site/Icon.astro';
import { site, identity, values, timeline, staff, facilities, yearsOfHistory, whatsappLink } from '../data/site';

const years = yearsOfHistory();
const groups = ['Dirección', 'Coordinación', 'Docentes'] as const;
const initials = (n: string) => n.replace(/^(Dr\.|Esp\.|Prof\.)\s*/, '').split(' ').slice(0, 2).map((w) => w[0]).join('');
const subnav = [
  { href: '#mision', label: 'Misión', icon: 'flag' },
  { href: '#valores', label: 'Valores', icon: 'heart-handshake' },
  { href: '#historia', label: 'Historia', icon: 'history' },
  { href: '#staff', label: 'Staff', icon: 'users-round' },
  { href: '#instalaciones', label: 'Instalaciones', icon: 'school' },
];
---

<SiteLayout
  title="Nosotros: misión, historia y staff · Colegio Aplicación"
  description={`Fundado el ${site.foundedDate} por la Diócesis del Táchira. Misión, visión, valores, historia, equipo directivo e instalaciones del Colegio Aplicación.`}
  active="nosotros"
>
  <PageHeader
    eyebrow="Nosotros"
    icon="landmark"
    title="Una comunidad que"
    highlight="educa para servir"
    intro={`Desde ${site.founded} acompañamos a las familias de Palo Gordo en la formación académica, humana y cristiana de sus hijos.`}
    image="/equipo.webp"
    imageAlt="Equipo directivo y docente del Colegio Aplicación"
    crumbs={[{ label: 'Nosotros' }]}
  />

  <!-- Subnavegación tipo chips (sticky en móvil, estilo app) -->
  <nav aria-label="Secciones de Nosotros" class="sticky top-0 lg:top-24 z-30 bg-ivory/90 backdrop-blur-md mt-2 lg:mt-4">
    <div class="container-site">
      <ul class="flex gap-2 overflow-x-auto py-3 px-5 -mx-5 lg:mx-0 lg:px-0 [scrollbar-width:none]">
        {subnav.map((s) => (
          <li><a href={s.href} class="press inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-white px-4 py-2 text-sm font-semibold text-navy shadow-sm hover:bg-navy hover:text-white transition-colors"><Icon name={s.icon} class="w-4 h-4" />{s.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- Misión y visión -->
  <section id="mision" class="container-site py-12 lg:py-20 scroll-mt-40">
    <div class="grid lg:grid-cols-2 gap-5" data-stagger>
      <article class="card p-7 lg:p-10 text-center lg:text-left flex flex-col items-center lg:items-start">
        <span class="chip-icon w-14 h-14 rounded-2xl bg-brand text-white"><Icon name="flag" class="w-7 h-7" /></span>
        <h2 class="mt-5 text-2xl lg:text-3xl font-extrabold text-navy">Misión</h2>
        <p class="mt-3 text-gray-600 leading-relaxed text-[15px] lg:text-lg">{identity.mission}</p>
      </article>
      <article class="rounded-[28px] p-7 lg:p-10 bg-navy text-white relative overflow-hidden text-center lg:text-left flex flex-col items-center lg:items-start">
        <div class="absolute -right-16 -bottom-16 w-56 h-56 rounded-full bg-aqua/20 blur-2xl"></div>
        <span class="relative chip-icon w-14 h-14 rounded-2xl bg-aqua text-deep"><Icon name="telescope" class="w-7 h-7" /></span>
        <h2 class="relative mt-5 text-2xl lg:text-3xl font-extrabold">Visión</h2>
        <p class="relative mt-3 text-blue-100 leading-relaxed text-[15px] lg:text-lg">{identity.vision}</p>
      </article>
    </div>
  </section>

  <!-- Valores -->
  <section id="valores" class="container-site pb-12 lg:pb-20 scroll-mt-40">
    <p class="eyebrow text-brand reveal"><Icon name="heart-handshake" class="w-4 h-4" />Valores</p>
    <h2 class="h-section mt-3 text-navy reveal">Lo que nos <span class="text-brand">mueve cada día</span></h2>
    <div class="mt-8 grid grid-cols-2 lg:grid-cols-3 gap-3 lg:gap-5" data-stagger>
      {values.map((v, i) => (
        <article class:list={['group rounded-[24px] p-5 lg:p-7 text-center lg:text-left flex flex-col items-center lg:items-start', i === 0 ? 'bg-brand text-white' : 'card']}>
          <span class:list={['icon-pop chip-icon w-12 h-12 rounded-2xl', i === 0 ? 'bg-white/15 text-aqua' : 'bg-brand/10 text-brand']}><Icon name={v.icon} class="w-6 h-6" /></span>
          <h3 class:list={['mt-4 font-extrabold lg:text-xl', i === 0 ? '' : 'text-navy']}>{v.title}</h3>
          <p class:list={['hidden lg:block mt-1 text-sm leading-relaxed', i === 0 ? 'text-blue-100' : 'text-gray-600']}>{v.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Historia + cifras -->
  <section id="historia" class="bg-white lg:rounded-[56px] lg:mx-6 py-12 lg:py-24 scroll-mt-40">
    <div class="container-site grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5 lg:sticky lg:top-44 self-start text-center lg:text-left">
        <p class="eyebrow text-brand reveal"><Icon name="history" class="w-4 h-4" />Historia</p>
        <h2 class="h-section mt-3 text-navy reveal">{years} años <span class="text-brand">educando para servir</span></h2>
        <p class="hidden lg:block mt-4 text-gray-600 leading-relaxed reveal">Inaugurado el {site.foundedDate} por iniciativa de monseñor Dr. Alejandro Fernández Feo, obispo de la Diócesis del Táchira, el plantel nació como centro de prácticas pedagógicas y hoy es un referente formativo de la región andina.</p>
        <div class="mt-6 grid grid-cols-2 gap-3 text-left" data-stagger>
          <div class="rounded-2xl bg-ivory p-4"><span class="text-brand"><Icon name="calendar-heart" /></span><p class="text-3xl font-extrabold text-navy mt-2" data-count={years}>{years}</p><p class="text-xs text-gray-500">años de historia</p></div>
          <div class="rounded-2xl bg-ivory p-4"><span class="text-brand"><Icon name="graduation-cap" /></span><p class="text-3xl font-extrabold text-navy mt-2" data-count="44">44</p><p class="text-xs text-gray-500">promociones de bachilleres</p></div>
          <div class="rounded-2xl bg-ivory p-4"><span class="text-brand"><Icon name="layers" /></span><p class="text-3xl font-extrabold text-navy mt-2" data-count="3">3</p><p class="text-xs text-gray-500">niveles educativos</p></div>
          <div class="rounded-2xl bg-navy text-white p-4"><span class="text-aqua"><Icon name="award" /></span><p class="text-3xl font-extrabold mt-2">Top 8</p><p class="text-xs text-blue-200">promedios del Táchira</p></div>
        </div>
      </div>
      <ol class="lg:col-span-7 relative space-y-8 lg:space-y-12 before:absolute before:left-[21px] before:top-2 before:bottom-2 before:w-[3px] before:rounded-full before:bg-gradient-to-b before:from-aqua before:to-brand">
        {timeline.map((t: any, i: number) => (
          <li class="relative pl-16 reveal">
            <span class:list={['absolute left-0 top-0 chip-icon w-11 h-11 rounded-full ring-8 ring-white', i === 0 ? 'bg-navy text-aqua' : 'bg-brand text-white']}><Icon name={t.icon} class="w-5 h-5" /></span>
            <p class="text-sm font-bold text-brand">{t.year}</p>
            <h3 class="text-xl lg:text-2xl font-extrabold text-navy mt-1">{t.title}</h3>
            <p class="mt-2 text-gray-600 leading-relaxed text-[15px] lg:text-base">{t.text}</p>
            <div class="ld mt-4 rounded-3xl aspect-[16/9]"><img src={t.image} alt={t.title} class="w-full h-full object-cover" loading="lazy" /></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Staff -->
  <section id="staff" class="container-site py-12 lg:py-24 scroll-mt-40">
    <p class="eyebrow text-brand reveal"><Icon name="users-round" class="w-4 h-4" />Staff</p>
    <h2 class="h-section mt-3 text-navy reveal">Las personas <span class="text-brand">detrás de cada logro</span></h2>
    {groups.map((g) => (
      <div class="mt-10">
        <h3 class="text-sm font-bold uppercase tracking-wider text-gray-500 mb-4 text-center lg:text-left">{g}</h3>
        <div class:list={['snap-row lg:grid-cols-4 lg:gap-5', staff.filter((p) => p.group === g).length === 1 && 'max-lg:justify-center']} data-stagger>
          {staff.filter((p) => p.group === g).map((p) => (
            <article class="w-[62%] sm:w-[38%] card p-3 text-center">
              {p.image ? (
                <div class="ld rounded-[22px] aspect-square"><img src={p.image} alt={`Foto de ${p.name}`} class="w-full h-full object-cover" loading="lazy" /></div>
              ) : (
                <div class="rounded-[22px] aspect-square bg-gradient-to-br from-brand to-deep text-white grid place-items-center text-4xl font-extrabold">{initials(p.name)}</div>
              )}
              <h4 class="mt-3 font-extrabold text-navy">{p.name}</h4>
              <p class="text-xs text-gray-500 mb-2">{p.role}</p>
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- Instalaciones -->
  <section id="instalaciones" class="relative bg-deep text-white rounded-[32px] lg:rounded-[56px] mx-3 lg:mx-6 overflow-hidden scroll-mt-40">
    <div class="absolute -left-24 -top-24 w-96 h-96 rounded-full bg-brand/50 blur-3xl"></div>
    <div class="relative container-site py-12 lg:py-24">
      <p class="eyebrow text-aqua reveal"><Icon name="school" class="w-4 h-4" />Instalaciones</p>
      <h2 class="h-section mt-3 reveal">Espacios para <span class="text-aqua">aprender y convivir</span></h2>
      <div class="snap-row lg:grid-cols-3 lg:gap-5 mt-8" data-stagger>
        {facilities.map((f, i) => (
          <article class:list={['w-[78%] sm:w-[46%] group', i === 0 && 'lg:col-span-2 lg:row-span-2']}>
            <div class:list={['ld ld-dark zoom rounded-[24px]', i === 0 ? 'aspect-[4/3] lg:aspect-auto lg:h-[calc(100%-5rem)]' : 'aspect-[4/3]']}>
              <img src={f.image} alt={f.title} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <h3 class="mt-3 font-extrabold text-lg">{f.title}</h3>
            <p class="hidden lg:block text-sm text-blue-100/80">{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-site pt-12 lg:pt-20">
    <div class="card p-7 lg:p-12 flex flex-col lg:flex-row items-center gap-5 lg:gap-6 text-center lg:text-left">
      <span class="chip-icon w-16 h-16 rounded-2xl bg-aqua/20 text-aqua-ink"><Icon name="calendar-days" class="w-8 h-8" /></span>
      <div class="flex-1"><h2 class="text-2xl lg:text-3xl font-extrabold text-navy">Ven a conocernos</h2><p class="hidden lg:block text-gray-600 mt-1">Agenda una visita guiada y recorre el colegio con la Coordinación.</p></div>
      <div class="flex flex-wrap justify-center gap-3"><a href={whatsappLink('Hola, quisiera agendar una visita al Colegio Aplicación.')} target="_blank" rel="noopener" class="btn-primary"><Icon brand name="whatsapp" class="w-5 h-5" />Agendar visita</a><a href="/admisiones" class="btn bg-ivory text-navy hover:bg-white"><Icon name="file-check" class="w-5 h-5" />Admisiones</a></div>
    </div>
  </section>
</SiteLayout>
