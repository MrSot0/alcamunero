---
// src/pages/seccion/[section].astro
// Listado de todos los artículos de una sección (Actualidad, Cultura, etc.)
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { sections, getArticlesBySection } from '../../data/articles';
import type { SectionId } from '../../data/articles';

export function getStaticPaths() {
  return (Object.keys(sections) as SectionId[]).map((id) => ({
    params: { section: id },
    props: { id },
  }));
}

interface Props {
  id: SectionId;
}

const { id } = Astro.props;
const section = sections[id];
const list = getArticlesBySection(id);
---

<Layout
  title={`${section.label} | Alcamunero`}
  description={section.description}
  active={id}
>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="mb-8 border-b-2 border-gray-900 pb-4">
      <nav aria-label="Ruta de navegación" class="text-xs text-gray-600 font-sans uppercase tracking-wider mb-2 flex items-center gap-2">
        <a href="/" class="hover:text-blue-800 hover:underline">Inicio</a>
        <span aria-hidden="true">/</span>
        <span>Secciones</span>
      </nav>
      <h1 class="text-3xl md:text-5xl font-serif font-bold text-gray-900">{section.label}</h1>
      <p class="mt-2 font-serif text-gray-700 max-w-2xl">{section.description}</p>
      <p class="mt-3 text-xs font-sans text-gray-500">
        {list.length} {list.length === 1 ? 'artículo' : 'artículos'}
      </p>
    </div>

    <div class="max-w-4xl divide-y divide-gray-300">
      {list.map((a) => <ArticleCard article={a} variant="list" />)}
    </div>
  </div>
</Layout>
